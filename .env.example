# ── PLAID CREDENTIALS ──────────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# Use 'sandbox' for testing (fake bank login), 'development' for real banks (free, up to 100 items)
PLAID_ENV=sandbox

# ── SERVER CONFIG ───────────────────────────────────────────────────────────
# Railway sets PORT automatically — don't change this
PORT=3000

# URL of your dashboard (used for CORS). Set to * to allow any origin while testing.
# Once deployed, set this to your actual dashboard URL e.g. https://evan.github.io/femi-finance
DASHBOARD_URL=*
